{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Side-lane routing catalog",
  "description": "Reviewed static evidence only. This schema does not activate or discover a provider route.",
  "type": "object",
  "required": ["catalog_version", "catalog_verified_on", "freshness_days", "routes"],
  "properties": {
    "catalog_version": {"type": "string", "minLength": 1},
    "catalog_verified_on": {"type": "string", "format": "date"},
    "currency": {"const": "USD"},
    "cost_contexts": {
      "type": "object",
      "required": ["native_default", "native_override", "glm", "policy"],
      "properties": {
        "native_default": {"const": "included-oauth"},
        "native_override": {"const": "extra-usage"},
        "glm": {"const": "prepaid-flat-rate"},
        "policy": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "evidence_policy": {
      "type": "object",
      "required": ["hard_gates", "behavioral_sources", "activation_requires", "community_role"],
      "properties": {
        "hard_gates": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "behavioral_sources": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "activation_requires": {"type": "array", "contains": {"const": "local-evaluation"}},
        "community_role": {"const": "evaluation-prior-only"}
      },
      "additionalProperties": false
    },
    "rate_cards": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["unit", "applicability", "verified_on", "source", "models"],
        "properties": {
          "unit": {"type": "string", "minLength": 1},
          "applicability": {"type": "string", "minLength": 1},
          "verified_on": {"type": "string", "format": "date"},
          "source": {"type": "string", "format": "uri"},
          "models": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["input_per_million", "output_per_million"],
              "properties": {
                "input_per_million": {"type": "number", "minimum": 0},
                "cached_input_per_million": {"type": "number", "minimum": 0},
                "cached_read_per_million": {"type": "number", "minimum": 0},
                "cache_write_per_million": {"type": "number", "minimum": 0},
                "output_per_million": {"type": "number", "minimum": 0},
                "reasoning_per_million": {"type": "number", "minimum": 0}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "metadata_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scope", "verified_on", "url"],
        "properties": {
          "scope": {"type": "string", "minLength": 1},
          "verified_on": {"type": "string", "format": "date"},
          "url": {"type": "string", "format": "uri"}
        },
        "additionalProperties": false
      }
    },
    "freshness_days": {
      "type": "object",
      "required": ["price", "evidence"],
      "properties": {
        "price": {"type": "integer", "minimum": 1},
        "evidence": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/route"}
    },
    "candidates": {
      "description": "Research registry only. Entries never activate a runtime provider or credential lookup.",
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["verified", "verified_on", "source"],
      "properties": {
        "verified": {"const": true},
        "verified_on": {"type": "string", "format": "date"},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "capability_evidence_entry": {
      "description": "Reviewed callability evidence for one capability on one route. Registration is never verification: an entry here says a bridge was observed to answer, and `limitations` says what that observation does not establish. Verified-only, like `$defs/evidence` — a capability that is not verified is left out of the block rather than recorded as a negative.",
      "type": "object",
      "required": ["verified", "verified_on", "source"],
      "properties": {
        "verified": {"const": true},
        "verified_on": {"type": "string", "format": "date"},
        "source": {"type": "string", "minLength": 1},
        "source_evidence_url": {"type": "string", "format": "uri"},
        "observed_tools": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "scope": {"type": "string", "minLength": 1},
        "limitations": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "composite_receipt": {
      "type": "object",
      "required": ["verified", "verified_on", "source", "receipt_ref"],
      "properties": {
        "verified": {"const": true},
        "verified_on": {"type": "string", "format": "date"},
        "source": {"type": "string", "minLength": 1},
        "receipt_ref": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "composite_evidence": {
      "type": "object",
      "required": ["mode", "auto_selection", "controlled_qualification"],
      "properties": {
        "mode": {"const": "controlled-member-plus-auto"},
        "auto_selection": {
          "type": "object",
          "required": ["selector", "gateway", "host", "protocol", "policy_revision", "policy_fingerprint", "attested_member", "receipt"],
          "properties": {
            "selector": {"type": "string", "minLength": 1},
            "gateway": {"const": "omniroute-router"},
            "host": {"const": "claude"},
            "protocol": {"const": "anthropic-compatible"},
            "policy_revision": {"type": "string", "minLength": 1},
            "policy_fingerprint": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
            "attested_member": {"type": "string", "minLength": 1},
            "receipt": {"$ref": "#/$defs/composite_receipt"}
          },
          "additionalProperties": false
        },
        "controlled_qualification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["attested_member", "provider", "model_vendor", "model", "gateway", "host", "protocol", "selector", "policy_revision", "policy_fingerprint", "receipt"],
            "properties": {
              "attested_member": {"type": "string", "minLength": 1},
              "provider": {"type": "string", "minLength": 1},
              "model_vendor": {"type": "string", "minLength": 1},
              "model": {"type": "string", "minLength": 1},
              "gateway": {"const": "omniroute-router"},
              "host": {"const": "claude"},
              "protocol": {"const": "anthropic-compatible"},
              "selector": {"type": "string", "minLength": 1},
              "policy_revision": {"type": "string", "minLength": 1},
              "policy_fingerprint": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
              "receipt": {"$ref": "#/$defs/composite_receipt"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "required": ["id", "provider", "gateway", "auth_method", "billable", "model_vendor", "model", "host", "mode", "state", "execution_allowlisted", "protocol"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "gateway": {"type": "string", "minLength": 1},
        "auth_method": {"enum": ["oauth", "provider-key"]},
        "billable": {"type": "boolean"},
        "explicit_only": {"type": "boolean"},
        "model_vendor": {"enum": ["claude", "openai", "glm", "deepseek", "kimi", "minimax", "cognition", "google", "xai", "routed-pool"]},
        "model": {"type": "string", "minLength": 1},
        "host": {"enum": ["codex", "claude", "devin"]},
        "mode": {"enum": ["review", "execute"]},
        "state": {"enum": ["discoverable", "executable"]},
        "execution_allowlisted": {"type": "boolean"},
        "allowlist_ref": {"type": "string", "minLength": 1},
        "protocol": {"enum": ["native-devin", "native-codex", "native-codex-readonly", "native-claude", "native-claude-readonly", "anthropic-compatible", "anthropic-compatible-readonly"]},
        "execution_location": {"enum": ["local-user-workspace", "cloud-only", "unknown"]},
        "connector_retention": {"enum": ["origin-host", "worker-host"]},
        "connector_evidence": {"$ref": "#/$defs/evidence"},
        "privacy_classes": {"type": "array", "items": {"type": "string"}},
        "capabilities": {
          "type": "object",
          "required": ["supported", "authority_roles"],
          "properties": {
            "supported": {"type": "array", "items": {"type": "string"}},
            "authority_roles": {
              "type": "array",
              "items": {"enum": ["worker", "reviewer", "coordinator"]}
            },
            "modalities": {"type": "array", "items": {"type": "string"}},
            "tools": {"type": "array", "items": {"type": "string"}},
            "context_window_tokens": {"type": "integer", "minimum": 1},
            "max_output_tokens": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        "cost_model": {
          "type": "object",
          "required": ["basis", "verified_on", "source"],
          "properties": {
            "basis": {"enum": ["native-oauth", "workspace-credits", "external-billable", "prepaid-flat-rate"]},
            "verified_on": {"type": "string", "format": "date"},
            "source": {"type": "string", "minLength": 1}
            ,"rates": {
              "type": "object",
              "required": ["unit", "input_per_million", "output_per_million"],
              "properties": {
                "unit": {"type": "string", "minLength": 1},
                "input_per_million": {"type": "number", "minimum": 0},
                "cached_input_per_million": {"type": "number", "minimum": 0},
                "cached_read_per_million": {"type": "number", "minimum": 0},
                "cache_write_per_million": {"type": "number", "minimum": 0},
                "output_per_million": {"type": "number", "minimum": 0},
                "reasoning_per_million": {"type": "number", "minimum": 0}
              },
              "additionalProperties": false
            },
            "rate_bands": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["rates"],
                "properties": {
                  "plan_state": {"type": "string", "minLength": 1},
                  "min_input_tokens": {"type": "integer", "minimum": 0},
                  "max_input_tokens": {"type": "integer", "minimum": 0},
                  "starts_on": {"type": "string", "format": "date"},
                  "expires_on": {"type": "string", "format": "date"},
                  "rates": {"$ref": "#/$defs/rates"}
                },
                "additionalProperties": false
              }
            },
            "acquisition": {
              "type": "object",
              "properties": {
                "monthly_fee_usd": {"type": "number", "minimum": 0},
                "setup_cost_usd": {"type": "number", "minimum": 0},
                "expected_overflow_usd": {"type": "number", "minimum": 0}
              },
              "additionalProperties": false
            }
          }
        },
        "behavioral_capabilities": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["score", "evidence_types"],
            "properties": {
              "score": {"type": "integer", "minimum": 0, "maximum": 100},
              "evidence_types": {
                "type": "array",
                "contains": {"const": "local-evaluation"},
                "items": {"enum": ["official-spec", "independent-benchmark", "community-signal", "local-evaluation", "provider-positioning"]}
              }
            },
            "additionalProperties": false
          }
        },
        "capability_evidence": {
          "description": "Per-capability reviewed callability evidence, keyed by the canonical capability name the route also names in `capabilities.supported`. Declared rather than left to the route's open property set, so the block is a validated shape instead of an unexamined comment: an entry that is not verified, carries no source, or adds a key this schema does not describe is refused. This block records evidence; it grants nothing, and no capability here is activated, discovered or looked up by the schema.",
          "type": "object",
          "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$"},
          "additionalProperties": {"$ref": "#/$defs/capability_evidence_entry"}
        },
        "community_signal_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "local_evaluation": {
          "allOf": [
            {"$ref": "#/$defs/evidence"},
            {
              "type": "object",
              "required": ["task_scores", "acceptance_rate"],
              "properties": {
                "task_scores": {
                  "type": "object",
                  "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 100}
                },
                "acceptance_rate": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
              }
            }
          ]
        },
        "routed_pool": {
          "description": "Opaque-selector pool route (OmniRoute-style). Every member carries fresh reviewed router-path evaluation identity; runtime admission also requires the configured routing policy contract to match the member set exactly, plus a fresh operator-supplied server policy snapshot binding selector, canonical members, revision, fingerprint, caps, fail-closed context policy, and provenance. An optional `composite_evidence` block declares controlled-member-plus-auto admission with separate native AUTO execution and per-member controlled mapping receipts.",
          "type": "object",
          "required": ["selector", "host", "protocol", "policy_revision", "evidence_provenance", "context_fit_fail_closed", "members"],
          "properties": {
            "selector": {"type": "string", "minLength": 1},
            "host": {"enum": ["codex", "claude", "devin"]},
            "protocol": {"type": "string", "minLength": 1},
            "policy_revision": {"type": "string", "minLength": 1},
            "expected_caps": {"type": "object"},
            "evidence_provenance": {"type": "string", "minLength": 1},
            "context_fit_fail_closed": {"const": true},
            "composite_evidence": {"$ref": "#/$defs/composite_evidence"},
            "members": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["provider", "model_vendor", "model", "attested_model", "evaluation", "capabilities"],
                "properties": {
                  "provider": {"type": "string", "minLength": 1},
                  "model_vendor": {"type": "string", "minLength": 1},
                  "model": {"type": "string", "minLength": 1},
                  "attested_model": {"type": "string", "minLength": 1},
                  "approx_context_tokens": {"type": "integer", "minimum": 1},
                  "max_output_tokens": {"type": "integer", "minimum": 1},
                  "capabilities": {
                    "type": "object",
                    "required": ["supported", "connectors", "privacy_classes"],
                    "properties": {
                      "supported": {"type": "array", "items": {"type": "string"}},
                      "connectors": {"type": "array", "items": {"type": "string"}},
                      "privacy_classes": {"type": "array", "items": {"type": "string"}}
                    },
                    "additionalProperties": false
                  },
                  "evaluation": {
                    "allOf": [
                      {"$ref": "#/$defs/evidence"},
                      {
                        "type": "object",
                        "required": ["identity", "task_scores", "acceptance_rate"],
                        "properties": {
                          "identity": {
                            "type": "object",
                            "required": ["gateway", "selector", "provider", "model", "host", "protocol", "policy_revision"],
                            "properties": {
                              "gateway": {"type": "string", "minLength": 1},
                              "selector": {"type": "string", "minLength": 1},
                              "provider": {"type": "string", "minLength": 1},
                              "model": {"type": "string", "minLength": 1},
                              "host": {"type": "string", "minLength": 1},
                              "protocol": {"type": "string", "minLength": 1},
                              "policy_revision": {"type": "string", "minLength": 1}
                            },
                            "additionalProperties": false
                          },
                          "task_scores": {
                            "type": "object",
                            "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 100}
                          },
                          "acceptance_rate": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "executable"}}},
          "then": {
            "required": ["allowlist_ref", "connector_retention", "connector_evidence", "cost_model", "privacy_classes", "capabilities", "behavioral_capabilities"]
          }
        },
        {
          "if": {
            "properties": {"state": {"const": "executable"}},
            "not": {"required": ["routed_pool"]}
          },
          "then": {"required": ["local_evaluation"]}
        },
        {
          "if": {"required": ["routed_pool"]},
          "then": {
            "properties": {
              "state": {"const": "executable"},
              "provider": {"const": "omniroute"},
              "gateway": {"const": "omniroute-router"},
              "model_vendor": {"const": "routed-pool"},
              "host": {"const": "claude"},
              "mode": {"const": "execute"},
              "protocol": {"const": "anthropic-compatible"},
              "resolved_model": {"const": null}
            },
            "not": {"required": ["local_evaluation"]}
          }
        },
        {
          "if": {"anyOf": [
            {"properties": {"model_vendor": {"const": "routed-pool"}}},
            {"properties": {"provider": {"const": "omniroute"}, "state": {"const": "executable"}}}
          ]},
          "then": {"required": ["routed_pool"]}
        }
      ],
      "description": "Executable routing entries require a reviewed cost basis, worker-host connector evidence, local task evidence, and cross-checking against the separate runtime allowlist."
    },
    "rates": {
      "type": "object",
      "required": ["unit", "input_per_million", "output_per_million"],
      "properties": {
        "unit": {"type": "string", "minLength": 1},
        "input_per_million": {"type": "number", "minimum": 0},
        "cached_input_per_million": {"type": "number", "minimum": 0},
        "cached_read_per_million": {"type": "number", "minimum": 0},
        "cache_write_per_million": {"type": "number", "minimum": 0},
        "output_per_million": {"type": "number", "minimum": 0},
        "reasoning_per_million": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["id", "state", "default_enabled", "provider", "model_vendor", "requested_model", "execution_location", "qualification_state", "model_evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "state": {"const": "candidate"},
        "default_enabled": {"const": false},
        "provider": {"type": "string", "minLength": 1},
        "model_vendor": {"type": "string", "minLength": 1},
        "requested_model": {"type": "string", "minLength": 1},
        "resolved_model": {"type": ["string", "null"]},
        "gateway": {"type": ["string", "null"], "minLength": 1},
        "endpoint": {"type": ["string", "null"], "format": "uri"},
        "auth_method": {"type": ["string", "null"], "minLength": 1},
        "host": {"type": ["string", "null"], "minLength": 1},
        "harness": {"type": ["string", "null"], "minLength": 1},
        "mode": {"type": ["string", "null"], "minLength": 1},
        "protocol": {"type": ["string", "null"], "minLength": 1},
        "reasoning_setting": {"type": ["string", "null"], "minLength": 1},
        "identity_stability": {"type": ["string", "null"], "minLength": 1},
        "execution_location": {"enum": ["local-user-workspace", "cloud-only", "unknown"]},
        "qualification_state": {"enum": ["research-only", "adapter-unqualified", "evaluation-required", "cloud-only-excluded", "identity-unverified"]},
        "endpoint_evidence": {"$ref": "#/$defs/evidence"},
        "model_evidence": {"$ref": "#/$defs/evidence"},
        "notes": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
